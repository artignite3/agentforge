# Generate local credentials with: python scripts/bootstrap.py
AGENTFORGE_API_KEY=
AGENTFORGE_SANDBOX_KEY=
POSTGRES_PASSWORD=
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_CORS_ORIGINS=["http://localhost:8080"]
AGENTFORGE_OPENAI_KEY=
AGENTFORGE_OPENAI_MODEL=gpt-4.1-mini
AGENTFORGE_GEMINI_KEY=
AGENTFORGE_GEMINI_MODEL=gemini-2.5-flash
# Conservative operator-set micro-USD/token estimates; verify against your provider contract.
AGENTFORGE_OPENAI_INPUT_RATE=1.0
AGENTFORGE_OPENAI_OUTPUT_RATE=5.0
AGENTFORGE_GEMINI_INPUT_RATE=1.0
AGENTFORGE_GEMINI_OUTPUT_RATE=5.0
# Docker Desktop usually uses GID 0; Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
